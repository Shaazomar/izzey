datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  ACCOUNTANT
  EMPLOYEE
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CONVERTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum ExpenseCategory {
  FUEL
  CLEANING_MATERIALS
  EQUIPMENT
  VEHICLE
  OFFICE
  MARKETING
  INSURANCE
  SALARY
  MAINTENANCE
  UTILITIES
  OTHER
}

enum JobStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum JobImageType {
  BEFORE
  AFTER
}

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  password       String
  role           Role            @default(EMPLOYEE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  JobAssignment  JobAssignment[]
}

model Customer {
  id           String      @id @default(uuid())
  name         String
  companyName  String?
  email        String      @unique
  phone        String?
  vatNumber    String?
  address      String
  city         String
  country      String      @default("Germany")
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  properties   Property[]
  quotations   Quotation[]
  invoices     Invoice[]
}

model Property {
  id          String      @id @default(uuid())
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  address     String
  city        String
  postalCode  String
  country     String      @default("Germany")
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  quotations  Quotation[]
}

model Quotation {
  id             String          @id @default(uuid())
  quoteNumber    String          @unique
  customerId     String
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  date           DateTime        @default(now())
  validUntil     DateTime
  status         QuotationStatus @default(DRAFT)
  subtotal       Decimal         @db.Decimal(12, 2)
  vatAmount      Decimal         @db.Decimal(12, 2)
  grandTotal     Decimal         @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  items          QuotationItem[]
  invoices       Invoice[]
  jobs           Job[]
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  serviceName String
  description String?
  quantity    Float
  unit        String    @default("Hour")
  unitPrice   Decimal   @db.Decimal(12, 2)
  discount    Float     @default(0)
  vatPercent  Float     @default(19)
  total       Decimal   @db.Decimal(12, 2)
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  quotationId   String?
  quotation     Quotation?    @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @db.Decimal(12, 2)
  vatAmount     Decimal       @db.Decimal(12, 2)
  grandTotal    Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         InvoiceItem[]
  payments      Payment[]
  jobs          Job[]
}

model InvoiceItem {
  id          String      @id @default(uuid())
  invoiceId   String
  invoice     Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceName String
  description String?
  quantity    Float
  unit        String      @default("Hour")
  unitPrice   Decimal     @db.Decimal(12, 2)
  discount    Float       @default(0)
  vatPercent  Float       @default(19)
  total       Decimal     @db.Decimal(12, 2)
}

model Payment {
  id            String        @id @default(uuid())
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(12, 2)
  paymentDate   DateTime      @default(now())
  paymentMethod PaymentMethod @default(BANK_TRANSFER)
  status        PaymentStatus @default(PAID)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Expense {
  id            String          @id @default(uuid())
  vendor        String
  category      ExpenseCategory
  amount        Decimal         @db.Decimal(12, 2)
  date          DateTime        @default(now())
  paymentMethod String          @default("Bank Transfer")
  receiptUrl    String?
  notes         String?
  isOfficial    Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Job {
  id             String             @id @default(uuid())
  quotationId    String?
  quotation      Quotation?         @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  invoiceId      String?
  invoice        Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  status         JobStatus          @default(SCHEDULED)
  startDate      DateTime
  completionDate DateTime?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  assignments    JobAssignment[]
  images         JobImage[]
  managementCost ManagementJobCost?
}

model JobAssignment {
  id         String @id @default(uuid())
  jobId      String
  job        Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  employeeId String
  employee   User   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model JobImage {
  id        String       @id @default(uuid())
  jobId     String
  job       Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  url       String
  type      JobImageType @default(BEFORE)
  createdAt DateTime     @default(now())
}

model ManagementJobCost {
  id             String   @id @default(uuid())
  jobId          String   @unique
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  realLabourCost Decimal  @default(0) @db.Decimal(12, 2)
  bonuses        Decimal  @default(0) @db.Decimal(12, 2)
  commission     Decimal  @default(0) @db.Decimal(12, 2)
  materialCost   Decimal  @default(0) @db.Decimal(12, 2)
  hiddenCosts    Decimal  @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SystemSetting {
  id                 String   @id @default(uuid())
  companyName        String   @default("Izzey Clean & Move")
  companyLogoUrl     String?
  vatNumber          String?
  invoicePrefix      String   @default("INV-")
  quotePrefix        String   @default("Q-")
  paymentTermsDays   Int      @default(14)
  currency           String   @default("EUR")
  language           String   @default("de")
  emailTemplatesJson String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
