# Postgres connection used by Prisma
DB_URL=postgresql://user:password@host:5432/database

NEXTAUTH_URL=https://your-domain.example
NEXTAUTH_SECRET=change-me

# Document storage (REQUIRED in production). Generated PDFs are uploaded to a private Supabase Storage bucket;
# nothing is written to the application filesystem. The bucket is created automatically on first use.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # server-side secret, never expose to the browser
SUPABASE_DOCUMENTS_BUCKET=documents
